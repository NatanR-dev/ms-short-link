// Using Rest Client Extension 
   // > code --install-extension humao.rest-client
      // OR > Ctrl+Shift+X > humao.rest-client

@acessToken = <acessToken>

### Create user
POST http://localhost:3000/user
Content-Type: application/json

{
  "name": "Natan Ribeiro",
  "email": "natan2@example.com",
  "password": "123456"
}

### Login (Auth)
POST http://localhost:3001/auth
Content-Type: application/json

{
  "email": "natan@example.com",
  "password": "123456" 
}

### Get user by ID (authenticated)
GET http://localhost:3000/user/1
Authorization: Bearer {{acessToken}}

### Create short link (authenticated)
POST http://localhost:3000/short-link
Content-Type: application/json
Authorization: Bearer {{acessToken}}

{
  "targetLink": "https://www.google.com.br"
}

### List user short links (authenticated)
GET http://localhost:3000/short-link/user/1
Authorization: Bearer {{acessToken}}

### Update short link (authenticated)
# Replace :id with the short link id
PUT http://localhost:3000/short-link/1 
Content-Type: application/json
Authorization: Bearer {{acessToken}}

{
  "targetLink": "https://www.github.com"
}

### Delete short link (authenticated)
# Replace :id with the short link id
DELETE http://localhost:3000/short-link/1 
Authorization: Bearer {{acessToken}}

### Redirect short link (public)
# Replace :shortenedLink with the shortened link code
GET http://localhost:3000/:shortenedLink

### Example user creation response
# (for reference only, not a request)
# {
#   "id": 1,
#   "name": "Natan Ribeiro",
#   "email": "natan@example.com",
